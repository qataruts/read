{
 "reciter": "Husary_64kbps",
 "reciterName": "محمود خليل الحصري — المرتّل",
 "ayat": {
  "a1326136a001": "بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ",
  "b7d1dbd1a641": "ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَـٰلَمِينَ",
  "9e331c2c6362": "ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ",
  "c40e415a7620": "مَـٰلِكِ يَوْمِ ٱلدِّينِ",
  "028c8c737050": "إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ",
  "1c486636d386": "ٱهْدِنَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ",
  "2864a36d27b3": "صِرَٰطَ ٱلَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ ٱلْمَغْضُوبِ عَلَيْهِمْ وَلَا ٱلضَّآلِّينَ",
  "5508ef77fb19": "قُلْ هُوَ ٱللَّهُ أَحَدٌ",
  "7a544109c5e4": "ٱللَّهُ ٱلصَّمَدُ",
  "c77d4195bbd1": "لَمْ يَلِدْ وَلَمْ يُولَدْ",
  "54140fde91fb": "وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ",
  "c29a840de4f2": "قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ",
  "38c17ed22f45": "مِن شَرِّ مَا خَلَقَ",
  "3d4adcf1ff05": "وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ",
  "c6a522a51b9e": "وَمِن شَرِّ ٱلنَّفَّـٰثَـٰتِ فِى ٱلْعُقَدِ",
  "4618a212befb": "وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ",
  "66f6deaae674": "قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ",
  "5def818cc393": "مَلِكِ ٱلنَّاسِ",
  "5fced4c9aade": "إِلَـٰهِ ٱلنَّاسِ",
  "368cb27da881": "مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ",
  "336c1445845d": "ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ",
  "6fafdb7ba608": "مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ",
  "1ecea523d307": "إِنَّآ أَعْطَيْنَـٰكَ ٱلْكَوْثَرَ",
  "e7e9acb71c60": "فَصَلِّ لِرَبِّكَ وَٱنْحَرْ",
  "ca4944e0fcf2": "إِنَّ شَانِئَكَ هُوَ ٱلْأَبْتَرُ",
  "64af40670b46": "وَٱلْعَصْرِ",
  "03ee153921bd": "إِنَّ ٱلْإِنسَـٰنَ لَفِى خُسْرٍ",
  "f46831381f33": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ وَتَوَاصَوْا۟ بِٱلْحَقِّ وَتَوَاصَوْا۟ بِٱلصَّبْرِ",
  "0e550df8051c": "لِإِيلَـٰفِ قُرَيْشٍ",
  "5352fab1322e": "إِۦلَـٰفِهِمْ رِحْلَةَ ٱلشِّتَآءِ وَٱلصَّيْفِ",
  "cb9625b5782c": "فَلْيَعْبُدُوا۟ رَبَّ هَـٰذَا ٱلْبَيْتِ",
  "deb8ac0cf8fd": "ٱلَّذِىٓ أَطْعَمَهُم مِّن جُوعٍ وَءَامَنَهُم مِّنْ خَوْفٍۭ",
  "c723ea6e95e1": "تَبَّتْ يَدَآ أَبِى لَهَبٍ وَتَبَّ",
  "6e27d516da2f": "مَآ أَغْنَىٰ عَنْهُ مَالُهُۥ وَمَا كَسَبَ",
  "91e3a1934630": "سَيَصْلَىٰ نَارًا ذَاتَ لَهَبٍ",
  "9e895c8b5ac2": "وَٱمْرَأَتُهُۥ حَمَّالَةَ ٱلْحَطَبِ",
  "ba275a4fddf9": "فِى جِيدِهَا حَبْلٌ مِّن مَّسَدٍۭ",
  "90b703681cff": "أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَـٰبِ ٱلْفِيلِ",
  "3ebd0624116d": "أَلَمْ يَجْعَلْ كَيْدَهُمْ فِى تَضْلِيلٍ",
  "6de11d8da5ec": "وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ",
  "678821e26c22": "تَرْمِيهِم بِحِجَارَةٍ مِّن سِجِّيلٍ",
  "52a088906e7c": "فَجَعَلَهُمْ كَعَصْفٍ مَّأْكُولٍۭ",
  "96e209eef1fb": "أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ",
  "c0e417f5d056": "وَوَضَعْنَا عَنكَ وِزْرَكَ",
  "b63802779072": "ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ",
  "4f16a7a7d018": "وَرَفَعْنَا لَكَ ذِكْرَكَ",
  "66efb9a80dff": "فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا",
  "0846adb698d5": "إِنَّ مَعَ ٱلْعُسْرِ يُسْرًا",
  "9496b9cbbf51": "فَإِذَا فَرَغْتَ فَٱنصَبْ",
  "2e06542148e4": "وَإِلَىٰ رَبِّكَ فَٱرْغَب",
  "6ccf0d338a3b": "أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ",
  "87c92d69c2ad": "فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ",
  "470230e174d2": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ",
  "e6d20aa11eb5": "فَوَيْلٌ لِّلْمُصَلِّينَ",
  "f314f232dbd6": "ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ",
  "dad3cbe45005": "ٱلَّذِينَ هُمْ يُرَآءُونَ",
  "969eeb6dc046": "وَيَمْنَعُونَ ٱلْمَاعُونَ",
  "d57dfdc21231": "ٱلْقَارِعَةُ",
  "ccb784b82355": "مَا ٱلْقَارِعَةُ",
  "7280d1d4f5a9": "وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ",
  "8a663e120433": "يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ",
  "923c3dcd782d": "وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ",
  "152dc4447d8b": "فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ",
  "e2b8d226a522": "فَهُوَ فِى عِيشَةٍ رَّاضِيَةٍ",
  "8ceabc70f9ce": "وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ",
  "2521595f72b5": "فَأُمُّهُۥ هَاوِيَةٌ",
  "f70cfa2165ce": "وَمَآ أَدْرَىٰكَ مَا هِيَهْ",
  "f77422b46bda": "نَارٌ حَامِيَةٌۢ"
 },
